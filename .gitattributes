# Enforce LF line endings for shell scripts and Linux packaging metadata.
# Windows checkouts (core.autocrlf) otherwise break bash/dash parsing
# (a CR after a line-continuation backslash silently ends the logical line)
# and corrupt maintainer scripts, desktop entries, and control files.
*.sh text eol=lf
*.service text eol=lf
*.desktop text eol=lf
DEBIAN/* text eol=lf
packaging/linux/**/* text eol=lf
*.spec text eol=lf
*.iss text eol=lf
*.wxs text eol=lf
