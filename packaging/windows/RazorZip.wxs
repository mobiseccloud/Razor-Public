<?xml version="1.0" encoding="UTF-8"?>
<!-- RazorZip MSI (WiX v3). Managed-deployment alternative to the Inno installer.
     SCOPE (same honesty rules as razorzip-setup.iss):
     - Default build installs the OPEN harness only (Core). Commercial files
       are included ONLY when built with -dCommercial=1 AND every staged file
       is named in the in-tree approved-binaries.txt with matching hash
       (currently: razor-train.exe + sidecar; quarantined bench/watch/decode
       are NOT referenced). Enforced by scripts/build-installers.ps1.
     Without it, the CommercialEngine feature below is excluded at compile time.
     - The MSI NEVER opens an email client, including during silent/GPO install.
       Trial requests happen post-install via the GUI "Trial" tab, the
        "Request 14-Day Trial" Start Menu shortcut (request-trial flag), or the
       installed trial-request-template.txt. Uninstall removes program files
       only; user data and license state outside the install dir are preserved.
     Build (harness-only, needs WiX v3 candle/light):
       candle RazorZip.wxs -dHarnessDir=<dotnet publish dir> -o obj\ -arch x64
       light obj\RazorZip.wixobj -o ..\..\..\dist\RazorZip-0.1.0.msi
     Commercial: only via scripts/build-installers.ps1 (gated, fail-closed).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="RazorZip" Language="1033" Version="0.1.0"
           Manufacturer="Mobisec Cloud" UpgradeCode="{9D2E5F8A-1B4C-4D7E-8F0A-3C6D9E1F2A5B}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="RazorZip open harness installer (Core features)" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- perMachine default. Managed deployment may request per-user layouts,
         but no per-user component configuration has been authored or tested —
         perMachine is the only supported mode in this release. -->

    <Feature Id="Harness" Title="Benchmark harness (Core)" Level="1">
      <ComponentGroupRef Id="HarnessFiles" />
    </Feature>
    <Feature Id="TrialShortcut" Title="Trial request shortcut" Level="1">
      <ComponentRef Id="TrialShortcutComponent" />
    </Feature>
<?ifdef Commercial ?>
    <Feature Id="CommercialEngine" Title="Commercial Razor trainer (allow-listed)"
             Description="razor-train.exe + integrity sidecar only. Quarantined bench/watch/decode are not packaged."
             Level="1">
      <ComponentGroupRef Id="CommercialFiles" />
    </Feature>
<?endif ?>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="MobiSecDir" Name="MobiSec">
          <Directory Id="INSTALLFOLDER" Name="RazorZip">
            <Directory Id="HarnessDir" Name="harness" />
<?ifdef Commercial ?>
            <Directory Id="EngineDir" Name="engine" />
<?endif ?>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="RazorMenu" Name="RazorZip" />
      </Directory>
    </Directory>

    <!-- Harness payload file list (HarnessFiles group, $(var.HarnessDir)) and the
         CommercialFiles group are NOT generated by any committed step:
         scripts/build-installers.ps1 hard-SKIPs the WiX path ("heat-harvest
         step not wired"). The .wxs is therefore currently UNBUILDABLE even
         with WiX installed — kept as reviewed scaffolding for the MSI
         milestone, not a working package definition. Do not present it as
         buildable until a heat harvest + candle/light run is evidenced. -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="TrialTemplateComponent" Guid="{A1B2C3D4-1111-4222-8333-444455556666}">
        <File Id="TrialTemplate" Name="trial-request-template.txt"
              Source="..\..\docs\trial\trial-request-template.txt" />
      </Component>
      <Component Id="TrialShortcutComponent" Guid="{A1B2C3D4-7777-4222-8333-444455556666}"
                 Directory="RazorMenu">
        <Shortcut Id="TrialShortcut" Name="Request 14-Day Trial"
                  Description="Open your email app with a prefilled trial request (nothing is sent automatically)"
                  Target="[HarnessDir]RazorBenchmark.exe" Arguments="--request-trial"
                  WorkingDirectory="HarnessDir" />
        <RegistryValue Root="HKCU" Key="Software\MobiSec\RazorZip" Name="TrialShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <FeatureRef Id="Harness">
      <ComponentRef Id="TrialTemplateComponent" />
    </FeatureRef>
  </Product>
</Wix>
